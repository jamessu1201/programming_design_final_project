# Copy to `.env` next to docker-compose.yml. Not committed.
# Docker Compose reads this file both for container env vars (`env_file:`) and
# for ${...} interpolation inside docker-compose.yml.

# ── Secrets (passed into the container) ──

# Discord bot token. project.py reads the `bot_token` env var first, then falls
# back to api_key/token.txt. Setting it here keeps the token out of the image.
bot_token=YOUR_DISCORD_BOT_TOKEN

# Optional. Each of these has a file fallback under api_key/ and the bot runs
# fine without them — only the command that needs one reports it's unconfigured.

# LLM (OpenAI-compatible) API key for cogs/llm.py -> api_key/llm.txt
# base_url / model names are in config.yaml.
llm_api_key=sk-...

# Taiwan CWA open data, for !weather and the LLM weather tool -> api_key/cwa.txt
# Free signup at https://opendata.cwa.gov.tw/
# cwa_api_key=CWA-...

# Unsplash, for !picture -> api_key/access_key.txt
# picture_access_key=

# Holodex, for !hololive -> api_key/api.txt
# holodex_api_key=

# ntfy auth token, only if your ntfy server requires it -> api_key/ntfy.txt
# ntfy_token=

# ── Deployment (used by docker-compose.yml interpolation) ──

# Directory holding your runtime data. Defaults to ./data if unset.
DCBOT_DATA=./data

# Hostname Traefik routes the dashboard on. Ignored if you don't use Traefik.
DASHBOARD_HOST=dashboard.example.com

# TZ=Asia/Taipei

# Everything else lives under DCBOT_DATA, not here:
#   config.yaml        channel/role IDs, LLM endpoint, points settings
#   api_key/oauth.json dashboard OAuth client_id/secret/redirect_uri + host/port
#                      (set "host": "0.0.0.0" so a reverse proxy can reach uvicorn)
#   private/owners.txt bot owner ids
#   cogs_local/        optional private cogs
